

pipeline {
  agent any

  options {
    timestamps()
  }

  stages {
    stage('Build') {
      steps {
        echo 'Building application...'
        // Simulate build time (e.g., npm install, bundling)
        sleep 5
      }
    }

    stage('Test') {
      steps {
        echo 'Running tests...'
        // Simulate unit/integration test runtime
        sleep 5
      }
    }

    stage('Deploy') {
      steps {
        echo 'Deploying application...'
        // Simulate deployment time (e.g., docker push, kubectl apply)
        sleep 5
      }
    }
  }

  post {
    success {
      echo 'Pipeline completed successfully.'
    }
    failure {
      echo 'Pipeline failed. Check logs for details.'
    }
  }
}

