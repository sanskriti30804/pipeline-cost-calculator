/*
  Declarative Jenkins Pipeline (simulation)
  ---------------------------------------
  This Jenkinsfile demonstrates a typical CI/CD pipeline flow:
  - Build: install dependencies / compile assets
  - Test: run automated tests / linters
  - Deploy: publish artifacts / deploy to an environment

  For this beginner-friendly demo, we simulate time with `sleep 5`
  to represent work being done by agents/executors.
*/

pipeline {
  agent any

  options {
    timestamps()
  }

  stages {
    stage('Build') {
      steps {
        echo 'Building application...'
        // Simulate build time (e.g., npm install, bundling)
        sleep 5
      }
    }

    stage('Test') {
      steps {
        echo 'Running tests...'
        // Simulate unit/integration test runtime
        sleep 5
      }
    }

    stage('Deploy') {
      steps {
        echo 'Deploying application...'
        // Simulate deployment time (e.g., docker push, kubectl apply)
        sleep 5
      }
    }
  }

  post {
    success {
      echo 'Pipeline completed successfully.'
    }
    failure {
      echo 'Pipeline failed. Check logs for details.'
    }
  }
}

